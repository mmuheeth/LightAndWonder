APP_NAME=LightAndWonder API
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GAME_CONTEXT_FILE=data/game_context.json
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=
OBS_EXE_PATH=C:\Program Files\obs-studio\bin\64bit\obs64.exe
OBS_LAUNCH_TIMEOUT=30
OBS_CAPTURES_DIR=obs-captures/obs
OBS_CONFIG_FILE=data/obs_config.json
OBS_WINDOW_FILE=data/obs_window.json
OBS_SCREENSHOT_FORMAT=bmp
OBS_SCREENSHOT_MODE=scene
GAF_NROBOT_HOST=127.0.0.1
GAF_NROBOT_PORT=8270
GAF_KEYWORD_TIMEOUT=30
GAF_PROBE_TIMEOUT=4
GAF_SETTLE_TIMEOUT=120
GAF_CONNECT_ATTEMPTS=3
GAF_CONNECT_RETRY_DELAY=2
